# Database — Supabase (Settings > Database > Connection string)
# IMPORTANT: must include +asyncpg — Supabase's dashboard gives you a plain
# `postgresql://` string, but SQLAlchemy's async engine needs to know which
# driver to use. Just add +asyncpg after postgresql.
#
# Use the "Transaction pooler" connection string (port 6543) for normal app
# traffic — it's what handles many concurrent short-lived connections well,
# which matches a lot of players hitting the API/sockets at once. session.py
# is already configured to work with it (statement_cache_size=0, NullPool).
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:[email protected]:6543/postgres

# Used ONLY by Alembic (migrations), not the running app. Use the "Session
# pooler" connection string instead — same dashboard, but port 5432, not
# 6543. Migrations run many DDL statements back-to-back in one session,
# and the Transaction pooler (above) isn't reliable for that pattern -
# you'll see DuplicatePreparedStatementError from it under a migration even
# though it's fine for the app's normal query traffic. If you leave this
# blank, migrations fall back to DATABASE_URL and you'll likely hit that
# error.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:[email protected]:5432/postgres

# Redis — Upstash (Database page > "Connect" > look for the ioredis / Node
# tab, which shows the plain connection string, NOT the "redis-cli" tab,
# which shows a shell command you'd type into a terminal, not an env value).
#
# REDIS_URL must be ONLY the URL itself:
#   rediss://default:PASSWORD@HOST:6379
# Note the double-s scheme — rediss:// (TLS), not redis://.
REDIS_URL=rediss://default:[email protected]:6379

# Groq (answer validation fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Game tuning
ROOM_CODE_LENGTH=5
MAX_PLAYERS_PER_ROOM=12
MIN_PLAYERS_TO_START=2
ROUND_LOCK_GRACE_SECONDS=3
CATEGORIES_PER_ROUND_MIN=4
CATEGORIES_PER_ROUND_MAX=5
